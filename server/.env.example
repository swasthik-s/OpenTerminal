# API server configuration (set these in your hosting provider's secret/environment settings)
API_HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=https://open-terminal-roan.vercel.app
API_KEY=replace-with-a-long-random-secret
DATA_DIR=/var/data

# AI: the key stays on the API server; never expose it as NEXT_PUBLIC_*
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Alpaca account handshake (paper account by default)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional additional trusted RSS/Atom feed URLs, comma-separated.
# You can also add/remove feeds in Settings -> RSS / Atom feeds.
RSS_FEEDS=
